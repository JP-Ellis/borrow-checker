# shellcheck shell=bash
# Note: Ubuntu 26.04 is required — webkitgtk-webdriver was renamed from
# webkit2gtk-driver in 24.04 and is only available from 26.04 onwards.
FROM ubuntu:26.04@sha256:f3d28607ddd78734bb7f71f117f3c6706c666b8b76cbff7c9ff6e5718d46ff64

LABEL org.opencontainers.image.source="https://github.com/JP-Ellis/borrow-checker"

ARG DEBIAN_FRONTEND=noninteractive

# Tauri system build deps, WebKitWebDriver (for tauri-driver), and Xvfb (display).
# hadolint shell=bash
RUN <<EOT bash
    set -euo pipefail -x
    apt-get update
    apt-get -y --no-install-recommends install \
        build-essential \
        pkg-config \
        libwebkit2gtk-4.1-dev \
        libssl-dev \
        libxdo-dev \
        libayatana-appindicator3-dev \
        librsvg2-dev \
        webkitgtk-webdriver \
        xvfb \
        libfaketime \
        curl \
        ca-certificates \
        git
    rm -rf /var/lib/apt/lists/*
EOT

ARG MISE_VERSION
# hadolint shell=bash
RUN --mount=type=secret,id=MISE_GITHUB_TOKEN \
  --mount=type=secret,id=GITHUB_TOKEN \
  <<EOT bash
    set -euo pipefail
    MISE_GITHUB_TOKEN="$(cat /run/secrets/MISE_GITHUB_TOKEN 2>/dev/null \
      || cat /run/secrets/GITHUB_TOKEN 2>/dev/null \
      || echo '')"
    export MISE_GITHUB_TOKEN
    export MISE_INSTALL_PATH="/usr/local/bin/mise"
    [ -n "${MISE_VERSION:-}" ] && export MISE_VERSION
    set -x
    curl https://mise.run | sh
EOT

ENV PATH="/root/.local/share/mise/shims:/root/.local/bin:${PATH}"

ARG NODE_VERSION
ARG BINSTALL_VERSION
ARG TRUNK_VERSION
ARG STYLANCE_VERSION
ARG AUBE_VERSION
# Install tools needed to build bc-app and run the desktop E2E suite.
# Rust stable builds the Tauri app; nightly is required by the cargo-script
# seed helper.  trunk + stylance compile the Leptos frontend.  tauri-cli
# drives the build; tauri-driver bridges WebdriverIO to WebKitWebDriver.
# MISE_CARGO_BINSTALL_ONLY=true prefers pre-built binaries; tools without
# a release binary (stylance-cli) fall back to cargo-install from source.
COPY mise.toml /build/mise.toml
# hadolint shell=bash
RUN --mount=type=secret,id=MISE_GITHUB_TOKEN \
  --mount=type=secret,id=GITHUB_TOKEN \
  <<EOT bash
    set -euo pipefail
    MISE_GITHUB_TOKEN="$(cat /run/secrets/MISE_GITHUB_TOKEN 2>/dev/null \
      || cat /run/secrets/GITHUB_TOKEN 2>/dev/null \
      || echo '')"
    export MISE_GITHUB_TOKEN MISE_CARGO_BINSTALL_ONLY=true
    set -x
    cd /build && mise trust && mise install core:rust
    rustup toolchain add nightly --profile minimal
    mise use -g "core:node@${NODE_VERSION}"
    mise use -g "aqua:cargo-bins/cargo-binstall@${BINSTALL_VERSION}"
    mise use -g "cargo:trunk@${TRUNK_VERSION}"
    mise use -g "cargo:stylance-cli@${STYLANCE_VERSION}"
    mise use -g "cargo:tauri-cli@2"
    mise use -g "cargo:tauri-driver@2"
    mise use -g "github:endevco/aube@${AUBE_VERSION}"
    mise activate > /etc/profile.d/mise.sh
EOT

# Pre-install WebdriverIO packages so the first container run is fast.
COPY e2e/package.json e2e/aube-lock.yaml /build/e2e/
# hadolint shell=bash
RUN <<EOT bash
    set -euo pipefail -x
    aube -C /build/e2e install
    rm -rf /var/lib/apt/lists/*
EOT

# CI=true: mise auto-trusts mounted config files.
# MISE_AUTO_INSTALL=false: prevent mise from installing tools in root mise.toml
# that are not needed for desktop E2E (cargo-hack, cargo-nextest, etc.)
# Cargo env vars mirror what actions-rust-lang/setup-rust-toolchain sets on the
# host runner so that container:linux-build compiles under identical conditions.
ENV CI=true \
  MISE_AUTO_INSTALL=false \
  CARGO_INCREMENTAL=0 \
  CARGO_PROFILE_DEV_DEBUG=0 \
  CARGO_REGISTRIES_CRATES_IO_PROTOCOL=sparse \
  CARGO_TERM_COLOR=always \
  RUST_BACKTRACE=short \
  RUSTFLAGS="-D warnings"

WORKDIR /repo
