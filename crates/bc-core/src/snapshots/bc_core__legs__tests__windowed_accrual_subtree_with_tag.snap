---
source: crates/bc-core/src/legs.rs
expression: query.sql
---
WITH RECURSIVE acct_tree(id) AS (SELECT ?1 UNION ALL SELECT a.id FROM accounts a INNER JOIN acct_tree ON a.parent_id = acct_tree.id), tag_subtree(id) AS (SELECT ?4 UNION ALL SELECT tg.id FROM tags tg INNER JOIN tag_subtree ON tg.parent_id = tag_subtree.id) SELECT p.rowid, p.transaction_id, p.account_id, p.date, p.position, p.amount, p.commodity, p.price_value, p.price_commodity, p.price_kind, p.cost_value, p.cost_commodity, p.cost_kind, p.spread_from, p.spread_until, (p.account_id IN (SELECT id FROM acct_tree) AND (CASE WHEN p.spread_from IS NOT NULL AND p.spread_until IS NOT NULL THEN p.spread_from <= p.spread_until AND p.spread_from < ?3 AND p.spread_until >= ?2 ELSE p.date >= ?2 AND p.date < ?3 END) AND (EXISTS (SELECT 1 FROM posting_tags pt WHERE pt.posting_id = p.id AND pt.tag_id IN (SELECT id FROM tag_subtree)) OR EXISTS (SELECT 1 FROM transaction_tags tt WHERE tt.transaction_id = p.transaction_id AND tt.tag_id IN (SELECT id FROM tag_subtree)))) FROM postings p WHERE p.transaction_id IN (SELECT e.transaction_id FROM postings e WHERE e.account_id IN (SELECT id FROM acct_tree) AND (CASE WHEN e.spread_from IS NOT NULL AND e.spread_until IS NOT NULL THEN e.spread_from <= e.spread_until AND e.spread_from < ?3 AND e.spread_until >= ?2 ELSE e.date >= ?2 AND e.date < ?3 END) AND (EXISTS (SELECT 1 FROM posting_tags pt WHERE pt.posting_id = e.id AND pt.tag_id IN (SELECT id FROM tag_subtree)) OR EXISTS (SELECT 1 FROM transaction_tags tt WHERE tt.transaction_id = e.transaction_id AND tt.tag_id IN (SELECT id FROM tag_subtree)))) ORDER BY p.transaction_id
