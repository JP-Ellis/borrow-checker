package borrow-checker:sdk@0.1.0;

/// Shared data types used by all plugin interfaces.
interface types {
    /// A calendar date.
    record date {
        year: s32,
        month: u8,
        day: u8,
    }

    /// A monetary amount, carried as a decimal string so no magnitude or
    /// precision is lost between plugin and host.
    ///
    /// Example: AUD 10.50 → value="10.50", commodity="AUD"
    record amount {
        /// Decimal value in canonical string form, e.g. "-12.50", "0.000000015".
        /// Trailing zeros are significant: they are the source's stated precision.
        value: string,
        /// Commodity code as the source names it, e.g. "AUD", "BTC".
        /// Final: the importer applies any renaming first, and the host resolves
        /// the code as given.
        commodity: string,
    }

    /// A figure stated against a posting's amount, per unit or in total.
    ///
    /// Beancount's `@ 332 AUD` is per-unit and `@@ 6.37 AUD` is total; a cost
    /// basis uses the same pair as `{105 AUD}` and `{{210 AUD}}`. The form is
    /// carried as stated: a total has no exact per-unit form in general. Both
    /// forms are stated without sign; the host rejects a negative figure.
    variant quote {
        /// One unit of the posting's amount is worth this much.
        per-unit(amount),
        /// The whole posting is worth this much.
        total(amount),
    }

    /// A posting's cost basis: what the leg was acquired for, as a lot.
    record cost {
        /// The acquisition cost, per unit or in total.
        basis: quote,
        /// The lot's acquisition date, if the source states one.
        date: option<date>,
        /// The lot's label, if the source states one.
        label: option<string>,
    }

    /// A typed metadata value.
    ///
    /// A plugin asserts a type here; the host decides what the key's type
    /// actually is, coercing or flagging the value at persist time.
    variant meta-value {
        /// Free text.
        text(string),
        /// A decimal number in canonical string form. Trailing zeros are
        /// significant: they are the source's stated precision.
        number(string),
        /// A boolean flag.
        boolean(bool),
        /// A calendar date.
        date(date),
        /// An instant in time, in RFC 3339 form.
        timestamp(string),
        /// A value paired with a commodity code.
        amount(amount),
        /// An account path, e.g. "Assets:Bank:Checking". Resolved to an id at
        /// persist time; a path naming no account is kept as text.
        account(string),
    }

    /// One metadata key-value pair.
    ///
    /// A key crosses exactly as the importer writes it; the host is what
    /// normalises. It lowercases first, so `Payee` and `payee` are one key,
    /// then requires `[a-z][a-z0-9_-]*` and at most 64 bytes. A key that still
    /// fails costs its own entry and nothing else — the rest of the row is
    /// kept. Repeated keys are permitted and ordered as stated.
    record meta-entry {
        /// The key this value is filed under.
        key: string,
        /// The value.
        value: meta-value,
    }

    /// How far a transaction has been confirmed against a statement.
    enum reconciliation {
        /// Not confirmed against any statement.
        unreconciled,
        /// Flagged for attention.
        flagged,
        /// Confirmed against a statement.
        reconciled,
    }

    /// BorrowChecker-only fields of a transaction, for an importer that
    /// round-trips them through its format.
    ///
    /// Import applies `reconciliation` and ignores `handle` and `delete`; those
    /// two are for a later apply step.
    record native-transaction {
        /// Opaque identifier the importer uses to find this transaction again.
        handle: option<string>,
        /// The reconciliation state to store. none leaves the default,
        /// unreconciled.
        reconciliation: option<reconciliation>,
        /// The stored transaction this one names should be removed.
        delete: bool,
    }

    /// BorrowChecker-only fields of a posting, for an importer that
    /// round-trips them through its format.
    ///
    /// Import applies the spread and ignores `handle`.
    record native-posting {
        /// Opaque identifier the importer uses to find this posting again.
        handle: option<string>,
        /// First day over which the posting's amount accrues.
        spread-from: option<date>,
        /// Last day over which the posting's amount accrues, inclusive.
        spread-until: option<date>,
    }

    /// A single posting leg of a raw transaction, prior to account-id resolution.
    record raw-posting {
        /// Account path, e.g. "Assets:Bank:Checking". Resolved to an id at persist time.
        account: string,
        /// Leg amount. none = elided (the residual that balances the transaction).
        amount: option<amount>,
        /// Per-account running balance after this posting, if reported.
        balance: option<amount>,
        /// Price annotation as the source stated it (`@` per unit, `@@` total).
        /// A negative figure is rejected by the host.
        price: option<quote>,
        /// Cost basis as the source stated it (`{}` per unit, `{{}}` total).
        /// A negative figure is rejected by the host.
        cost: option<cost>,
        /// Tag names for this leg, resolved to ids at persist time.
        tags: list<string>,
        /// Typed key-value metadata for this leg, in display order.
        metadata: list<meta-entry>,
        /// BorrowChecker-only fields, if the importer carries them.
        native: option<native-posting>,
    }

    /// Where a raw transaction came from, for diagnostics.
    ///
    /// A source is not always a file: a plugin may call an HTTP API or read a
    /// database. `display` is the human-facing text a diagnostic prints; `uri`
    /// is an optional machine-addressable form ("file:///ledger/2025.beancount#L412",
    /// "https://api.example/tx/88f3") that a host may use to offer navigation.
    record source-location {
        /// Human-readable location, e.g. "statements/june.csv row 14".
        display: string,
        /// Optional addressable form. Absent when the source has no address.
        uri: option<string>,
    }

    /// A parsed transaction prior to account binding. One or more postings.
    record raw-transaction {
        date: date,
        description: string,
        reference: option<string>,
        tags: list<string>,
        metadata: list<meta-entry>,
        source-location: option<source-location>,
        postings: list<raw-posting>,
        /// BorrowChecker-only fields, if the importer carries them.
        native: option<native-transaction>,
    }

    /// An account coming into existence on `date`.
    record account-open {
        date: date,
        /// Account path, e.g. "Assets:Bank:Checking".
        account: string,
        /// Commodity codes the account may hold, the first being its default.
        /// Codes are final: the importer applies its own renaming before
        /// emitting them, and the host resolves each one as given. An empty
        /// list states nothing about the account's commodities.
        commodities: list<string>,
        source-location: option<source-location>,
    }

    /// An account ceasing to exist on `date`.
    record account-close {
        date: date,
        account: string,
        source-location: option<source-location>,
    }

    /// One item an importer produces, in source order.
    variant directive {
        transaction(raw-transaction),
        open(account-open),
        close(account-close),
    }

    /// How one source fared: read and parsed, or given up on.
    variant source-status {
        /// Parsed; the payload counts the directives the source yielded.
        parsed(u32),
        /// Not read or not parsed; the payload is the reason, for a person.
        /// The source contributes no directives.
        failed(string),
    }

    /// One source an import touched, and how it fared.
    ///
    /// An importer reading several sources reports each one here, so a source
    /// it gave up on reaches the host as a failure rather than as missing rows.
    record source-outcome {
        /// The source, e.g. "statements/2025-06.csv".
        source: source-location,
        /// Whether it parsed.
        status: source-status,
    }

    /// What a successful `parse` returns.
    record import-output {
        /// Every directive, in source order.
        directives: list<directive>,
        /// Every source the import touched, in the order it read them. An
        /// importer that fails as a whole on any bad source may report each
        /// source as parsed, or report none.
        sources: list<source-outcome>,
    }

    /// Opaque JSON blob passed through from the ImportProfile config field.
    type import-config = string;

    /// Errors produced during an import operation.
    variant import-error {
        invalid-config(string),
        parse(string),
        missing-field(string),
        bad-value(string),
    }
}

/// The importer interface that every importer plugin must export.
interface importer {
    use types.{import-output, import-config, import-error};

    /// Returns the SDK ABI version this plugin was compiled against.
    sdk-abi: func() -> u32;

    /// Returns the stable plugin name, e.g. "csv". Must be unique across plugins.
    name: func() -> string;

    /// Read and parse this importer's configured sources into directives, in
    /// source order, with each source's outcome.
    ///
    /// A source that cannot be read or parsed may fail on its own, reported in
    /// `sources`, while the rest still yield directives. An `import-error`
    /// fails the whole import.
    ///
    /// The importer resolves and reads its own files from the host-preopened
    /// documents root; the host passes only the opaque config JSON.
    ///
    /// Note: `import` is a reserved WIT keyword, so this function is named `parse`.
    parse: func(config: import-config) -> result<import-output, import-error>;

    /// Check a config for coherence without reading any files.
    ///
    /// The host calls this before every `parse`, and may also call it on its
    /// own — when an import profile is saved, for instance — so configuration
    /// errors can surface at authoring time. It must not perform I/O.
    validate: func(config: import-config) -> result<_, import-error>;
}

/// The exporter interface: render a snapshot of the ledger as files.
///
/// The host assembles the snapshot from its own store; the plugin turns it
/// into one or more files in its format and returns their contents. The host
/// decides where they are written.
interface exporter {
    use types.{date, amount, quote, cost, meta-entry, reconciliation};

    /// How much of the ledger's bookkeeping the export carries.
    enum export-level {
        /// What a person edits day to day.
        working,
        /// Everything, for a complete and durable copy.
        archive,
    }

    /// One posting leg of an exported transaction.
    record export-posting {
        /// Opaque identifier the host uses to find this posting again on
        /// import. none when the posting has none to give.
        handle: option<string>,
        /// Account path, e.g. "Assets:Bank:Checking".
        account: string,
        /// Leg amount. none = elided.
        amount: option<amount>,
        /// Price annotation, per unit or total.
        price: option<quote>,
        /// Cost basis, per unit or total.
        cost: option<cost>,
        /// Tag names for this leg.
        tags: list<string>,
        /// Typed key-value metadata for this leg, in display order.
        metadata: list<meta-entry>,
        /// First day over which the posting's amount accrues.
        spread-from: option<date>,
        /// Last day over which the posting's amount accrues, inclusive.
        spread-until: option<date>,
    }

    /// One transaction of the snapshot.
    record export-transaction {
        /// Opaque identifier the host uses to find this transaction again on
        /// import.
        handle: string,
        date: date,
        description: string,
        /// Whether, and how far, the transaction is confirmed.
        reconciliation: reconciliation,
        tags: list<string>,
        metadata: list<meta-entry>,
        postings: list<export-posting>,
        /// The postings carry no elided leg and their weights sum to non-zero
        /// in some commodity.
        unbalanced: bool,
    }

    /// One account of the snapshot.
    record export-account {
        /// Account path, e.g. "Assets:Bank:Checking".
        path: string,
        opened-on: option<date>,
        closed-on: option<date>,
        /// Commodity codes the account may hold, the first being its default.
        commodities: list<string>,
        /// Host-rendered `bc-` fields, such as the account kind. The plugin
        /// prints them verbatim as metadata lines.
        extra: list<meta-entry>,
    }

    /// One commodity of the snapshot.
    record export-commodity {
        code: string,
        /// Host-rendered `bc-` fields describing the commodity. The plugin
        /// prints them verbatim as metadata lines.
        extra: list<meta-entry>,
    }

    /// One budget of the snapshot.
    record export-budget {
        /// Account path the budget applies to.
        account: string,
        /// First day the budget applies.
        effective-from: date,
        /// The period word, such as `monthly`, written verbatim.
        period: string,
        /// A fixed target amount, if the budget has one.
        target: option<amount>,
        /// A target expression, if the budget has one.
        expression: option<string>,
        /// Host-rendered `bc-` fields, such as rollover and intent. The plugin
        /// prints them verbatim as metadata lines.
        extra: list<meta-entry>,
    }

    /// A stated balance of an account on a date.
    record export-balance {
        date: date,
        account: string,
        amount: amount,
    }

    /// Everything one export covers.
    record export-snapshot {
        level: export-level,
        accounts: list<export-account>,
        commodities: list<export-commodity>,
        transactions: list<export-transaction>,
        budgets: list<export-budget>,
        balances: list<export-balance>,
    }

    /// One file the export produces.
    record export-file {
        /// Path relative to the export root.
        path: string,
        contents: string,
    }

    /// Why an export produced nothing.
    variant export-error {
        /// The plugin does not export.
        unsupported,
        /// The format cannot spell these items; each entry names one.
        unspellable(list<string>),
        /// Any other failure, described for a person.
        other(string),
    }

    /// Render `snapshot` as files in this plugin's format.
    ///
    /// Note: `export` is a reserved WIT keyword, so the name is escaped as
    /// `%export`; bindings still call it `export`.
    %export: func(snapshot: export-snapshot) -> result<list<export-file>, export-error>;
}

/// Log severity levels, matching the tracing crate conventions.
interface logger {
    /// Log severity level.
    enum log-level {
        trace,
        debug,
        info,
        warn,
        error,
    }

    /// A single structured log field (key-value pair).
    record log-field {
        /// The field name.
        key: string,
        /// The field value formatted as a string.
        value: string,
    }

    /// Emit a structured log entry. The host routes it through its tracing
    /// subscriber, attributed to the calling plugin via `target = "bc::plugin"`.
    log: func(level: log-level, message: string, fields: list<log-field>);
}

/// The WASM component world that every BorrowChecker plugin must satisfy.
world borrow-checker {
    import logger;    // host provides: plugin logging
    export importer;  // plugin provides: import capability
    export exporter;  // plugin provides: export capability
}
