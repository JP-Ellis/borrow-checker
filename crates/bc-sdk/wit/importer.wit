package borrow-checker:sdk@0.1.0;

/// Shared data types used by all plugin interfaces.
interface types {
    /// A calendar date.
    record date {
        year: s32,
        month: u8,
        day: u8,
    }

    /// A monetary amount in minor units to avoid floating-point imprecision.
    ///
    /// Example: AUD 10.50 → minor-units=1050, currency="AUD", scale=2
    record amount {
        /// Minor units (e.g. cents). Negative for debits.
        minor-units: s64,
        /// ISO 4217 currency code, e.g. "AUD".
        currency: string,
        /// Number of decimal places, e.g. 2 for AUD cents.
        scale: u8,
    }

    /// A single posting leg of a raw transaction, prior to account-id resolution.
    record raw-posting {
        /// Account path, e.g. "Assets:Bank:Checking". Resolved to an id at persist time.
        account: string,
        /// Leg amount. none = elided (the residual that balances the transaction).
        amount: option<amount>,
        /// Per-account running balance after this posting, if reported.
        balance: option<amount>,
        /// Optional free-text note for this leg.
        note: option<string>,
        /// Tag names for this leg, resolved to ids at persist time.
        tags: list<string>,
    }

    /// Where a raw transaction came from, for diagnostics.
    ///
    /// A source is not always a file: a plugin may call an HTTP API or read a
    /// database. `display` is the human-facing text a diagnostic prints; `uri`
    /// is an optional machine-addressable form ("file:///ledger/2025.beancount#L412",
    /// "https://api.example/tx/88f3") that a host may use to offer navigation.
    record source-location {
        /// Human-readable location, e.g. "statements/june.csv row 14".
        display: string,
        /// Optional addressable form. Absent when the source has no address.
        uri: option<string>,
    }

    /// A parsed transaction prior to account binding. One or more postings.
    record raw-transaction {
        date: date,
        payee: option<string>,
        description: string,
        note: option<string>,
        reference: option<string>,
        tags: list<string>,
        extra-dates: list<tuple<string, date>>,
        source-location: option<source-location>,
        postings: list<raw-posting>,
    }

    /// Opaque JSON blob passed through from the ImportProfile config field.
    type import-config = string;

    /// Errors produced during an import operation.
    variant import-error {
        invalid-config(string),
        parse(string),
        missing-field(string),
        bad-value(string),
    }
}

/// The importer interface that every importer plugin must export.
interface importer {
    use types.{raw-transaction, import-config, import-error};

    /// Returns the SDK ABI version this plugin was compiled against.
    sdk-abi: func() -> u32;

    /// Returns the stable plugin name, e.g. "csv". Must be unique across plugins.
    name: func() -> string;

    /// Read and parse this importer's configured sources into raw transactions.
    ///
    /// The importer resolves and reads its own files from the host-preopened
    /// documents root; the host passes only the opaque config JSON.
    ///
    /// Note: `import` is a reserved WIT keyword, so this function is named `parse`.
    parse: func(config: import-config) -> result<list<raw-transaction>, import-error>;

    /// Check a config for coherence without reading any files.
    ///
    /// The host calls this before every `parse`, and may also call it on its
    /// own — when an import profile is saved, for instance — so configuration
    /// errors can surface at authoring time. It must not perform I/O.
    validate: func(config: import-config) -> result<_, import-error>;
}

/// The exporter interface that exporter plugins will export.
///
/// Not yet part of any world — will be added to `world borrow-checker` in a
/// future milestone once export plugin support is introduced.
interface exporter {
}

/// Log severity levels, matching the tracing crate conventions.
interface logger {
    /// Log severity level.
    enum log-level {
        trace,
        debug,
        info,
        warn,
        error,
    }

    /// A single structured log field (key-value pair).
    record log-field {
        /// The field name.
        key: string,
        /// The field value formatted as a string.
        value: string,
    }

    /// Emit a structured log entry. The host routes it through its tracing
    /// subscriber, attributed to the calling plugin via `target = "bc::plugin"`.
    log: func(level: log-level, message: string, fields: list<log-field>);
}

/// The WASM component world that every BorrowChecker plugin must satisfy.
world borrow-checker {
    import logger;    // host provides: plugin logging
    export importer;  // plugin provides: import capability
}
