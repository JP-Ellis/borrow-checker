{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "borrow-checker",
  "version": "0.1.0",
  "identifier": "me.jpellis.borrow-checker",
  "build": {
    "beforeDevCommand": "trunk serve --config ../bc-ui/Trunk.toml",
    "beforeBuildCommand": "trunk build --config ../bc-ui/Trunk.toml --no-default-features --features csr",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../bc-ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "borrow-checker",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "withGlobalTauri": true
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": []
  }
}
