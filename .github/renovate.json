{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", ":disableDevDependencies"],
  "timezone": "Australia/Melbourne",
  "pre-commit": {
    "enabled": true
  },
  "git-submodules": {
    "enabled": true
  },
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "automerge": true,
  "rebaseWhen": "conflicted",
  "packageRules": [
    {
      "matchPackageNames": ["taiki-e/install-action"],
      "schedule": "before 4am on monday"
    },
    {
      "description": "Crates from the wasmtime repository are published in lockstep and must be upgraded together.",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["wasmtime", "wasmtime-*"],
      "groupName": "wasmtime"
    },
    {
      "description": "Only raise Cargo PRs when the manifest requirement itself has to change; in-range bumps are picked up by the weekly lock file maintenance.",
      "matchManagers": ["cargo"],
      "rangeStrategy": "replace"
    }
  ]
}
